  "sentences": [
    {
      "id": "vyjm-v.01",
      "text": "V{y|i} jste naši noví kamarádi!",
      "gaps": [{ "rule": "vyjm", "word": "vy" }]
    },
    {
      "id": "vyjm-v.02",
      "text": "Maják je v{y|i}soký a bílý.",
      "gaps": [{ "rule": "vyjm", "word": "vysokyy" }]
    },
    {
      "id": "vyjm-v.03",
      "text": "Pes na pláži v{y|i}je na měsíc.",
      "gaps": [{ "rule": "vyjm", "word": "vyyt" }]
    },
    {
      "id": "vyjm-v.04",
      "text": "Děti na lodi radostně v{ý|í}skaly.",
      "gaps": [{ "rule": "vyjm", "word": "vyyskat" }]
    },
    {
      "id": "vyjm-v.05",
      "text": "Delfíni obv{y|i}kle plavou ve skupinách.",
      "gaps": [{ "rule": "vyjm", "word": "obvykle" }]
    },
    {
      "id": "vyjm-v.06",
      "text": "Kráva u moře žv{ý|í}ká trávu.",
      "gaps": [{ "rule": "vyjm", "word": "zxvyykat" }]
    },
    {
      "id": "vyjm-v.07",
      "text": "V{y|i}dra se potápí pro rybu.",
      "gaps": [{ "rule": "vyjm", "word": "vydra" }]
    },
    {
      "id": "vyjm-v.08",
      "text": "Ponorka v{y|i}plula z přístavu.",
      "gaps": [{ "rule": "vyjm-prefix", "word": "vyplout" }]
    },
    {
      "id": "vyjm-v.09",
      "text": "Velryba se v{y|i}nořila u lodi.",
      "gaps": [{ "rule": "vyjm-prefix", "word": "vynorxit-se" }]
    },
    {
      "id": "vyjm-v.10",
      "text": "Jedeme na v{ý|í}let k moři.",
      "gaps": [{ "rule": "vyjm-prefix", "word": "vyylet" }]
    },
    {
      "id": "vyjm-v.11",
      "text": "Z majáku je krásný v{ý|í}hled.",
      "gaps": [{ "rule": "vyjm-prefix", "word": "vyyhled" }]
    },
    {
      "id": "vyjm-v.12",
      "text": "Na lodi byl velký pov{y|i}k.",
      "gaps": [{ "rule": "vyjm", "word": "povyk" }]
    },
    {
      "id": "vyjm-v.13",
      "text": "Kovář pracuje u v{ý|í}hně.",
      "gaps": [{ "rule": "vyjm", "word": "vyyhenx" }]
    },
    {
      "id": "vyjm-v.14",
      "text": "Tuleni si zv{y|i}kli na studenou vodu.",
      "gaps": [{ "rule": "vyjm", "word": "zvyknout-si" }]
    },
    {
      "id": "vyjm-v.15",
      "text": "Kdo v{y|i}hrál závod delfínů?",
      "gaps": [{ "rule": "vyjm-prefix", "word": "vyhraat" }]
    },
    {
      "id": "vyjm-v.16",
      "text": "V{ý|í}ška vln je dva metry.",
      "gaps": [{ "rule": "vyjm", "word": "vyysxka" }]
