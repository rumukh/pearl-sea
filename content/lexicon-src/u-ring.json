  "sentences": [
    {
      "id": "u-ring.01",
      "text": "{Ú|Ů}hoř se schovává mezi kameny.",
      "gaps": [{ "rule": "u-zacatek", "word": "uuhorx" }]
    },
    {
      "id": "u-ring.02",
      "text": "Na {ú|ů}tesu sedí racek.",
      "gaps": [{ "rule": "u-zacatek", "word": "uutes" }]
    },
    {
      "id": "u-ring.03",
      "text": "Dnes nemám žádný {ú|ů}kol.",
      "gaps": [{ "rule": "u-zacatek", "word": "uukol" }]
    },
    {
      "id": "u-ring.04",
      "text": "Rybáři mají velký {ú|ů}lovek.",
      "gaps": [{ "rule": "u-zacatek", "word": "uulovek" }]
    },
    {
      "id": "u-ring.05",
      "text": "Chobotnice má {ú|ů}kryt ve skále.",
      "gaps": [{ "rule": "u-zacatek", "word": "uukryt" }]
    },
    {
      "id": "u-ring.06",
      "text": "V {ú|ů}noru je moře studené.",
      "gaps": [{ "rule": "u-zacatek", "word": "uunor" }]
    },
    {
      "id": "u-ring.07",
      "text": "V {ú|ů}stí řeky žijí ryby.",
      "gaps": [{ "rule": "u-zacatek", "word": "uustii" }]
    },
    {
      "id": "u-ring.08",
      "text": "Dnes v noci je {ú|ů}plněk.",
      "gaps": [{ "rule": "u-zacatek", "word": "uuplnexk" }]
    },
    {
      "id": "u-ring.09",
      "text": "V mořské vodě je s{ů|ú}l.",
      "gaps": [{ "rule": "u-uprostred", "word": "suol" }]
    },
    {
      "id": "u-ring.10",
      "text": "Delfíni plavou dol{ů|ú} ke dnu.",
      "gaps": [{ "rule": "u-uprostred", "word": "doluo" }]
    },
    {
      "id": "u-ring.11",
      "text": "Po potápění jdeme dom{ů|ú}.",
      "gaps": [{ "rule": "u-uprostred", "word": "domuo" }]
    },
    {
      "id": "u-ring.12",
      "text": "U moře stojí bílý d{ů|ú}m.",
      "gaps": [{ "rule": "u-uprostred", "word": "duom" }]
    },
    {
      "id": "u-ring.13",
      "text": "Na pláži cválá k{ů|ú}ň.",
      "gaps": [{ "rule": "u-uprostred", "word": "kuonx" }]
    },
    {
      "id": "u-ring.14",
      "text": "Po ne{ú|ů}spěchu to delfín zkusil znovu.",
      "gaps": [{ "rule": "u-predpona", "word": "neuuspexch", "test": "úspěch" }]
    },
    {
      "id": "u-ring.15",
      "text": "Plachta má tvar troj{ú|ů}helníku.",
      "gaps": [{ "rule": "u-predpona", "word": "trojuuhelniik", "test": "úhel" }]
    },
    {
      "id": "u-ring.16",
      "text": "Med{ú|ů}za se vznáší ve vodě.",
      "gaps": [{ "rule": "u-prejate", "word": "meduuza" }]
    },
    {
      "id": "u-ring.17",
      "text": "Kolem krab{ů|ú} plavou malé rybky.",
      "gaps": [{ "rule": "u-uprostred", "word": "krab" }]
    },
    {
      "id": "u-ring.18",
      "text": "Do zátoky vede {ú|ů}zký pr{ů|ú}liv.",
      "gaps": [
        { "rule": "u-zacatek", "word": "uuzkyy" },
        { "rule": "u-uprostred", "word": "pruoliv" }
      ]
    },
    {
      "id": "u-ring.19",
      "text": "Delfín má na tváři {ú|ů}směv.",
      "gaps": [{ "rule": "u-zacatek", "word": "uusmexv" }]
    }
  ]
