  "sentences": [
    { "id": "vyjm-p.01", "text": "P{y|i}skoun je p{y|i}šný na své p{y|i}sky.", "gaps": [{ "rule": "vyjm", "word": "pyskoun" }, { "rule": "vyjm", "word": "pysxnyy" }, { "rule": "vyjm", "word": "pysk" }] },
    { "id": "vyjm-p.02", "text": "Pirát nese těžký p{y|i}tel mincí.", "gaps": [{ "rule": "vyjm", "word": "pytel" }] },
    { "id": "vyjm-p.03", "text": "Ptakop{y|i}sk umí plavat i potápět se.", "gaps": [{ "rule": "vyjm", "word": "ptakopysk" }] },
    { "id": "vyjm-p.04", "text": "V jeskyni u moře visí netop{ý|í}ři.", "gaps": [{ "rule": "vyjm", "word": "netopyyr" }] },
    { "id": "vyjm-p.05", "text": "Včely nosí p{y|i}l z květů.", "gaps": [{ "rule": "vyjm", "word": "pyl" }] },
    { "id": "vyjm-p.06", "text": "Kůň na pláži má mokrá kop{y|i}ta.", "gaps": [{ "rule": "vyjm", "word": "kopyto" }] },
    { "id": "vyjm-p.07", "text": "Námořník klop{ý|í}tl o lano.", "gaps": [{ "rule": "vyjm", "word": "klopyytnout" }] },
    { "id": "vyjm-p.08", "text": "Mořská hladina se třp{y|i}tí ve slunci.", "gaps": [{ "rule": "vyjm", "word": "trxpytit-se" }] },
    { "id": "vyjm-p.09", "text": "Rybář chytá ryby na třp{y|i}tku.", "gaps": [{ "rule": "vyjm", "word": "trxpytka" }] },
    { "id": "vyjm-p.10", "text": "Medúzka se při pochvale zap{ý|í}řila.", "gaps": [{ "rule": "vyjm", "word": "zapyyrxit-se" }] },
    { "id": "vyjm-p.11", "text": "Racek se na útesu čep{ý|í}ří.", "gaps": [{ "rule": "vyjm", "word": "cxepyyrxit-se" }] },
    { "id": "vyjm-p.12", "text": "Slep{ý|í}š není had, ale ještěrka.", "gaps": [{ "rule": "vyjm", "word": "slepyysx" }] },
    { "id": "vyjm-p.13", "text": "Na zahradě u moře roste p{ý|í}r.", "gaps": [{ "rule": "vyjm", "word": "pyyr" }] },
    { "id": "vyjm-p.14", "text": "P{ý|í}cha předchází pád.", "gaps": [{ "rule": "vyjm", "word": "pyycha" }] },
    { "id": "vyjm-p.15", "text": "Tuleň se p{y|i}šní svými vousy.", "gaps": [{ "rule": "vyjm", "word": "pysxnit-se" }] },
    { "id": "vyjm-p.16", "text": "V p{y|i}tlíku mám mušle.", "gaps": [{ "rule": "vyjm", "word": "pytliik" }] },
    { "id": "vyjm-p.17", "text": "Racek je načep{ý|í}řený a mokrý.", "gaps": [{ "rule": "vyjm", "word": "nacxepyyrxenyy" }] },
    { "id": "vyjm-p.18", "text": "Včely op{y|i}lují květy.", "gaps": [{ "rule": "vyjm", "word": "opylovat" }] },
    { "id": "vyjm-p.19", "text": "Na pláži je teplý p{í|ý}sek.", "gaps": [{ "rule": "obojetna-i", "word": "piisek" }] },
    { "id": "vyjm-p.20", "text": "P{i|y}rát hledá ztracený poklad.", "gaps": [{ "rule": "obojetna-i", "word": "piraat" }] },
    { "id": "vyjm-p.21", "text": "Malá chobotnice je p{i|y}lná žákyně.", "gaps": [{ "rule": "obojetna-i", "word": "pilnyy" }] },
    { "id": "vyjm-p.22", "text": "Racek ztratil bílé p{í|ý}rko.", "gaps": [{ "rule": "obojetna-i", "word": "piirko" }] }
  ]
