  "sentences": [
    { "id": "vyjm-b.01", "text": "Delfíni b{y|i}dlí v teplém moři.", "gaps": [{ "rule": "vyjm", "word": "bydlit" }] },
    { "id": "vyjm-b.02", "text": "Krab b{y|i}l celý den schovaný pod kamenem.", "gaps": [{ "rule": "vyjm", "word": "byyt" }] },
    { "id": "vyjm-b.03", "text": "Chobotnice je moudrá b{y|i}tost.", "gaps": [{ "rule": "vyjm", "word": "bytost" }] },
    { "id": "vyjm-b.04", "text": "Pob{y|i}t u moře se nám líbil.", "gaps": [{ "rule": "vyjm", "word": "pobyt" }] },
    { "id": "vyjm-b.05", "text": "Ze svačiny mi zb{y|i}l jen malý kousek.", "gaps": [{ "rule": "vyjm", "word": "zbyyt" }] },
    { "id": "vyjm-b.06", "text": "Je to zb{y|i}tečný strach, žralok spí.", "gaps": [{ "rule": "vyjm", "word": "zbytecxnyy" }] },
    { "id": "vyjm-b.07", "text": "Do konce výletu zb{ý|í}vá jeden den.", "gaps": [{ "rule": "vyjm", "word": "zbyyvat" }] },
    { "id": "vyjm-b.08", "text": "Na pláži přib{ý|í}vá turistů.", "gaps": [{ "rule": "vyjm", "word": "prxibyyvat" }] },
    { "id": "vyjm-b.09", "text": "Večer ub{ý|í}vá světla.", "gaps": [{ "rule": "vyjm", "word": "ubyyvat" }] },
    { "id": "vyjm-b.10", "text": "V zátoce b{ý|í}vá klidná voda.", "gaps": [{ "rule": "vyjm", "word": "byyvat" }] },
    { "id": "vyjm-b.11", "text": "Delfín chce, ab{y|i} si s ním děti hrály.", "gaps": [{ "rule": "vyjm", "word": "aby" }] },
    {
      "id": "vyjm-b.12",
      "text": "Kdyb{y|i} b{y|i}lo teplo, šli b{y|i}chom plavat.",
      "gaps": [{ "rule": "vyjm", "word": "kdyby" }, { "rule": "vyjm", "word": "byyt" }, { "rule": "vyjm", "word": "byyt" }]
    },
    { "id": "vyjm-b.13", "text": "Teta b{y|i}dlí v Přib{y|i}slavi.", "gaps": [{ "rule": "vyjm", "word": "bydlit" }, { "rule": "vyjm", "word": "prxibyslav" }] },
    { "id": "vyjm-b.14", "text": "Chobotnice má ob{y|i}dlí v jeskyni.", "gaps": [{ "rule": "vyjm", "word": "obydlii" }] },
    { "id": "vyjm-b.15", "text": "Tuleni ob{ý|í}vají studená moře.", "gaps": [{ "rule": "vyjm", "word": "obyyvat" }] },
    { "id": "vyjm-b.16", "text": "V ob{ý|í}vacím pokoji je akvárium.", "gaps": [{ "rule": "vyjm", "word": "obyyvacii" }] },
    { "id": "vyjm-b.17", "text": "V přístavu je ub{y|i}tovna pro námořníky.", "gaps": [{ "rule": "vyjm", "word": "ubytovna" }] },
    { "id": "vyjm-b.18", "text": "Ub{y|i}tovali jsme se v chatě u moře.", "gaps": [{ "rule": "vyjm", "word": "ubytovat" }] },
