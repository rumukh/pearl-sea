        { "rule": "predpona-predlozka", "word": "podplout" },
        { "rule": "predpona-predlozka" }
      ]
    },
    {
      "id": "prefix.05",
      "text": "Racek letí {nad mořem|nadmořem}.",
      "gaps": [{ "rule": "predpona-predlozka" }]
    },
    {
      "id": "prefix.06",
      "text": "Delfín {nadskočil|nad skočil} radostí.",
      "gaps": [{ "rule": "predpona-predlozka", "word": "nadskocxit" }]
    },
    {
      "id": "prefix.07",
      "text": "Lachtan {předběhl|před běhl} tuleně.",
      "gaps": [{ "rule": "predpona-predlozka", "word": "prxedbexhnout" }]
    },
    {
      "id": "prefix.08",
      "text": "Pojďme si {zaplavat|za plavat} do zátoky.",
      "gaps": [{ "rule": "predpona-predlozka", "word": "zaplavat-si" }]
    },
    {
      "id": "prefix.09",
      "text": "Kapitán {nastoupil|na stoupil} {na loď|naloď}.",
      "gaps": [
        { "rule": "predpona-predlozka", "word": "nastoupit" },
        { "rule": "predpona-predlozka" }
      ]
    },
    {
      "id": "prefix.10",
      "text": "Ponorka vyplula {z přístavu|zpřístavu}.",
      "gaps": [{ "rule": "predpona-predlozka" }]
    },
    {
      "id": "prefix.11",
      "text": "Tuleň {odpočívá|od počívá} {na ledu|naledu}.",
      "gaps": [
        { "rule": "predpona-predlozka", "word": "odpocxiivat" },
        { "rule": "predpona-predlozka" }
      ]
    },
    {
      "id": "prefix.12",
      "text": "Na otázku neznám o{d|t}pověď.",
      "gaps": [{ "rule": "predpona-souhlaska", "word": "odpovexdx" }]
    },
    {
      "id": "prefix.13",
      "text": "Kapitán připojil svůj po{d|t}pis.",
      "gaps": [{ "rule": "predpona-souhlaska", "word": "podpis" }]
    },
    {
      "id": "prefix.14",
      "text": "Námořníci poslouchají pře{d|t}pověď počasí.",
      "gaps": [{ "rule": "predpona-souhlaska", "word": "prxedpovexdx" }]
    },
    {
      "id": "prefix.15",
      "text": "Nad článkem je velký na{d|t}pis.",
