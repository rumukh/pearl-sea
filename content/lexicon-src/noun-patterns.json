  "sentences": [
    { "id": "vzor.01", "text": "Krab{i|y} lezou po kamenech.", "gaps": [{ "rule": "vzor", "word": "krab", "case": 1, "number": "pl" }] },
    { "id": "vzor.02", "text": "Vidím na pláži krab{y|i}.", "gaps": [{ "rule": "vzor", "word": "krab", "case": 4, "number": "pl" }] },
    { "id": "vzor.03", "text": "Racek si hraje s krab{y|i}.", "gaps": [{ "rule": "vzor", "word": "krab", "case": 7, "number": "pl" }] },
    { "id": "vzor.04", "text": "Losos{i|y} plavou proti proudu.", "gaps": [{ "rule": "vzor", "word": "losos", "case": 1, "number": "pl" }] },
    { "id": "vzor.05", "text": "Medvěd chytá losos{y|i}.", "gaps": [{ "rule": "vzor", "word": "losos", "case": 4, "number": "pl" }] },
    { "id": "vzor.06", "text": "Holub{i|y} sedí na stožáru.", "gaps": [{ "rule": "vzor", "word": "holub", "case": 1, "number": "pl" }] },
    { "id": "vzor.07", "text": "Námořník krmí holub{y|i}.", "gaps": [{ "rule": "vzor", "word": "holub", "case": 4, "number": "pl" }] },
    { "id": "vzor.08", "text": "Na moři jsou krásné ostrov{y|i}.", "gaps": [{ "rule": "vzor", "word": "ostrov", "case": 1, "number": "pl" }] },
    { "id": "vzor.09", "text": "Kolem lodi plavou ryb{y|i}.", "gaps": [{ "rule": "vzor", "word": "ryba", "case": 1, "number": "pl" }] },
    { "id": "vzor.10", "text": "Rybáři přivázali loď lan{y|i}.", "gaps": [{ "rule": "vzor", "word": "lano", "case": 7, "number": "pl" }] },
    { "id": "vzor.11", "text": "Delfíni si hrají s míč{i|y}.", "gaps": [{ "rule": "vzor", "word": "miicx", "case": 7, "number": "pl" }] },
    { "id": "vzor.12", "text": "Želv{y|i} kladou vejce do písku.", "gaps": [{ "rule": "vzor", "word": "zxelva", "case": 1, "number": "pl" }] },
    { "id": "vzor.13", "text": "Vidíš ty veselé delfín{y|i}?", "gaps": [{ "rule": "vzor", "word": "delfiin", "case": 4, "number": "pl" }] },
    { "id": "vzor.14", "text": "Mezi kameny se schovávají úhoř{i|y}.", "gaps": [{ "rule": "vzor", "word": "uuhorx", "case": 1, "number": "pl" }] },
    { "id": "vzor.15", "text": "Rybář nese ryby v koš{i|y}.", "gaps": [{ "rule": "vzor", "word": "kosx", "case": 6, "number": "sg" }] }
  ]
}
