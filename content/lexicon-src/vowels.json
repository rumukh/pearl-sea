  "sentences": [
    {
      "id": "vowels.01",
      "text": "Ryb{á|a}ř chytil velkou rybu.",
      "gaps": [{ "rule": "delka", "word": "rybaarx" }]
    },
    {
      "id": "vowels.02",
      "text": "Na pl{á|a}ži je teplý písek.",
      "gaps": [{ "rule": "delka", "word": "plaazx" }]
    },
    {
      "id": "vowels.03",
      "text": "Delf{í|i}n skáče přes vlny.",
      "gaps": [{ "rule": "delka", "word": "delfiin" }]
    },
    {
      "id": "vowels.04",
      "text": "N{á|a}mořník stojí u kormidla.",
      "gaps": [{ "rule": "delka", "word": "naamorxniik" }]
    },
    {
      "id": "vowels.05",
      "text": "Maj{á|a}k svítí lodím na cestu.",
      "gaps": [{ "rule": "delka", "word": "majaak" }]
    },
    {
      "id": "vowels.06",
      "text": "Lodě kotví v př{í|i}stavu.",
      "gaps": [{ "rule": "delka", "word": "prxiistav" }]
    },
    {
      "id": "vowels.07",
      "text": "V z{á|a}toce je klidná voda.",
      "gaps": [{ "rule": "delka", "word": "zaatoka" }]
    },
    {
      "id": "vowels.08",
      "text": "Na útesu roste červený kor{á|a}l.",
      "gaps": [{ "rule": "delka", "word": "koraal" }]
    },
    {
      "id": "vowels.09",
      "text": "Na letišti ukážeš p{a|á}s.",
      "gaps": [{ "rule": "delka", "word": "pas" }]
    },
    {
      "id": "vowels.10",
      "text": "Mám r{á|a}da mořské koníky.",
      "gaps": [{ "rule": "delka", "word": "raad" }]
    },
    {
      "id": "vowels.11",
      "text": "Delfín plaval d{á|a}l a d{á|a}l.",
      "gaps": [
        { "rule": "delka", "word": "daal" },
        { "rule": "delka", "word": "daal" }
      ]
    },
    {
      "id": "vowels.12",
      "text": "Do přístavu zbývá jedna m{í|i}le.",
      "gaps": [{ "rule": "delka", "word": "miile" }]
    },
    {
      "id": "vowels.13",
      "text": "Mořská v{í|i}la zpívá na skále.",
      "gaps": [{ "rule": "delka", "word": "viila" }]
    },
    {
      "id": "vowels.14",
      "text": "Na pobřeží stojí bílá v{i|í}la s bazénem.",
      "gaps": [{ "rule": "delka", "word": "vila" }]
    },
    {
      "id": "vowels.15",
      "text": "Dám ti dobrou r{a|á}du.",
      "gaps": [{ "rule": "delka", "word": "rada" }]
    },
    {
      "id": "vowels.16",
      "text": "Námořník si utáhl p{á|a}s.",
      "gaps": [{ "rule": "delka", "word": "paas" }]
    },
    {
      "id": "vowels.17",
      "text": "Krab se na nás m{i|í}le usmál.",
      "gaps": [{ "rule": "delka", "word": "mile" }]
    }
  ]
