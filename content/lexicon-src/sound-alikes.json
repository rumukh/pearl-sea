  "sentences": [
    {
      "id": "alike.01",
      "text": "Chci b{ý|í}t potápěčem.",
      "gaps": [{ "rule": "vyjm", "word": "byyt" }]
    },
    {
      "id": "alike.02",
      "text": "Hodiny na majáku b{i|y}ly poledne.",
