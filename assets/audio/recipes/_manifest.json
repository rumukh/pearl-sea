{
  "$comment": "Source for assets/audio/manifest.json (scripts/audio/manifest.mjs measures every file and writes the manifest). Sounds, tiers, events, music states and throttles are S5's; the shell maps rules events and its own ui.* and fx.* cues through this table. A screen mood the pack does not list (map, results, finale) plays the grotto loop (the shell's musicFor).",
  "packId": "pearl-sea-audio",
  "sampleRate": 48000,
  "channels": 1,
  "buses": {
    "music": {
      "defaultVolume": 1,
      "note": "Loops are mastered to their loudness tier (music -23 LUFS, musicCalm -26 LUFS), so play the bus at 1.0 by default; the parents' settings scale it down."
    },
    "effects": {
      "defaultVolume": 1,
      "note": "Effects are mastered to their tier; playEffect has no per-call gain, so the mix is in the files."
    }
  },
  "loudnessTargets": {
    "feedback": {
      "target": -15,
      "measure": "momentary-max",
      "use": "answer chimes, coins, stars, stickers, unlocks, fanfares, rewards"
    },
    "character": {
      "target": -16,
      "measure": "momentary-max",
      "use": "eggs, hatching, growing, monsters, Inkoustíci, Bublinka's bubble"
    },
    "soft": {
      "target": -18,
      "measure": "momentary-max",
      "use": "not quite, not now, hints, wiping: always gentle, never punishing"
    },
    "ui": {
      "target": -21,
      "measure": "momentary-max",
      "use": "taps, keys, screen changes, story pages: frequent, so quiet"
    },
    "music": {
      "target": -23,
      "measure": "integrated",
      "use": "grotto and battle loops, the victory sting"
    },
    "musicCalm": {
      "target": -26,
      "measure": "integrated",
      "use": "practice loop: unobtrusive while the child thinks"
    }
  },
