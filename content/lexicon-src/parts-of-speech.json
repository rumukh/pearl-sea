  "sentences": [
    { "id": "pos.01", "text": "Malá ryba rychle plave pod vodou.", "marks": [{ "t": "Malá", "word": "malyy", "pos": "adj" }, { "t": "ryba", "word": "ryba", "pos": "noun" }, { "t": "rychle", "word": "rychle", "pos": "adv" }, { "t": "plave", "word": "plavat", "pos": "verb" }, { "t": "pod", "word": "pod", "pos": "prep" }, { "t": "vodou", "word": "voda", "pos": "noun" }] },
    { "id": "pos.02", "text": "Delfín a želva plavou k ostrovu.", "marks": [{ "t": "Delfín", "word": "delfiin", "pos": "noun" }, { "t": "a", "word": "a", "pos": "conj" }, { "t": "želva", "word": "zxelva", "pos": "noun" }, { "t": "plavou", "word": "plavat", "pos": "verb" }, { "t": "k", "word": "k", "pos": "prep" }, { "t": "ostrovu", "word": "ostrov", "pos": "noun" }] },
    { "id": "pos.03", "text": "Hurá, vidím tři velké velryby!", "marks": [{ "t": "Hurá", "word": "huraa", "pos": "interj" }, { "t": "vidím", "word": "vidext", "pos": "verb" }, { "t": "tři", "word": "trxi", "pos": "num" }, { "t": "velké", "word": "velkyy", "pos": "adj" }, { "t": "velryby", "word": "velryba", "pos": "noun" }] },
    { "id": "pos.04", "text": "My jsme našli zlatou perlu.", "marks": [{ "t": "My", "word": "my", "pos": "pron" }, { "t": "jsme", "word": "byyt", "pos": "verb" }, { "t": "našli", "word": "najiit", "pos": "verb" }, { "t": "zlatou", "word": "zlatyy", "pos": "adj" }, { "t": "perlu", "word": "perla", "pos": "noun" }] },
    { "id": "pos.05", "text": "Ať žije ponorka Bublinka!", "marks": [{ "t": "Ať", "word": "atx", "pos": "part" }, { "t": "žije", "word": "zxiit", "pos": "verb" }, { "t": "ponorka", "word": "ponorka", "pos": "noun" }, { "t": "Bublinka", "word": "bublinka.ponorka", "pos": "noun" }] },
    { "id": "pos.06", "text": "Žbluňk, žabka skočila do vody.", "marks": [{ "t": "Žbluňk", "word": "zxblunxk", "pos": "interj" }, { "t": "žabka", "word": "zxabka", "pos": "noun" }, { "t": "skočila", "word": "skocxit", "pos": "verb" }, { "t": "do", "word": "do", "pos": "prep" }, { "t": "vody", "word": "voda", "pos": "noun" }] },
    { "id": "pos.07", "text": "Dnes je moře tiché, ale studené.", "marks": [{ "t": "Dnes", "word": "dnes", "pos": "adv" }, { "t": "je", "word": "byyt", "pos": "verb" }, { "t": "moře", "word": "morxe", "pos": "noun" }, { "t": "tiché", "word": "tichyy", "pos": "adj" }, { "t": "ale", "word": "ale", "pos": "conj" }, { "t": "studené", "word": "studenyy", "pos": "adj" }] },
    { "id": "pos.08", "text": "Kéž bychom našli poklad!", "marks": [{ "t": "Kéž", "word": "keezx", "pos": "part" }, { "t": "bychom", "word": "byyt", "pos": "verb" }, { "t": "našli", "word": "najiit", "pos": "verb" }, { "t": "poklad", "word": "poklad", "pos": "noun" }] },
    { "id": "pos.09", "text": "Ano, ten krab je můj kamarád.", "marks": [{ "t": "Ano", "word": "ano", "pos": "part" }, { "t": "ten", "word": "ten", "pos": "pron" }, { "t": "krab", "word": "krab", "pos": "noun" }, { "t": "je", "word": "byyt", "pos": "verb" }, { "t": "můj", "word": "muoj", "pos": "pron" }, { "t": "kamarád", "word": "kamaraad", "pos": "noun" }] },
    { "id": "pos.10", "text": "Pět rybek plave nahoře u hladiny.", "marks": [{ "t": "Pět", "word": "pext", "pos": "num" }, { "t": "rybek", "word": "rybka", "pos": "noun" }, { "t": "plave", "word": "plavat", "pos": "verb" }, { "t": "nahoře", "word": "nahorxe", "pos": "adv" }, { "t": "u", "word": "u", "pos": "prep" }, { "t": "hladiny", "word": "hladina", "pos": "noun" }] },
    { "id": "pos.11", "text": "Oni se potápějí, protože hledají mušle.", "marks": [{ "t": "Oni", "word": "on", "pos": "pron" }, { "t": "potápějí", "word": "potaapext-se", "pos": "verb" }, { "t": "protože", "word": "protozxe", "pos": "conj" }, { "t": "hledají", "word": "hledat", "pos": "verb" }, { "t": "mušle", "word": "musxle", "pos": "noun" }] },
    { "id": "pos.12", "text": "Fuj, tahle voda je slaná!", "marks": [{ "t": "Fuj", "word": "fuj", "pos": "interj" }, { "t": "tahle", "word": "tenhle", "pos": "pron" }, { "t": "voda", "word": "voda", "pos": "noun" }, { "t": "je", "word": "byyt", "pos": "verb" }, { "t": "slaná", "word": "slanyy", "pos": "adj" }] },
    { "id": "pos.13", "text": "Prý tam žije mořská saň.", "marks": [{ "t": "Prý", "word": "pryy", "pos": "part" }, { "t": "tam", "word": "tam", "pos": "adv" }, { "t": "žije", "word": "zxiit", "pos": "verb" }, { "t": "mořská", "word": "morxskyy", "pos": "adj" }, { "t": "saň", "word": "sanx", "pos": "noun" }] },
    { "id": "pos.14", "text": "Když svítí slunce, voda je teplá.", "marks": [{ "t": "Když", "word": "kdyzx", "pos": "conj" }, { "t": "svítí", "word": "sviitit", "pos": "verb" }, { "t": "slunce", "word": "slunce", "pos": "noun" }, { "t": "voda", "word": "voda", "pos": "noun" }, { "t": "je", "word": "byyt", "pos": "verb" }, { "t": "teplá", "word": "teplyy", "pos": "adj" }] },
    { "id": "pos.15", "text": "Bác, vlna zbořila hrad z písku.", "marks": [{ "t": "Bác", "word": "baac", "pos": "interj" }, { "t": "vlna", "word": "vlna", "pos": "noun" }, { "t": "zbořila", "word": "zborxit", "pos": "verb" }, { "t": "hrad", "word": "hrad", "pos": "noun" }, { "t": "z", "word": "z", "pos": "prep" }, { "t": "písku", "word": "piisek", "pos": "noun" }] },
    { "id": "pos.16", "text": "První delfín je rychlejší než druhý.", "marks": [{ "t": "První", "word": "prvnii", "pos": "num" }, { "t": "delfín", "word": "delfiin", "pos": "noun" }, { "t": "je", "word": "byyt", "pos": "verb" }, { "t": "rychlejší", "word": "rychlyy", "pos": "adj" }, { "t": "než", "word": "nezx", "pos": "conj" }, { "t": "druhý", "word": "druhyy", "pos": "num" }] },
    { "id": "pos.17", "text": "Deset racků sedí na stožáru.", "marks": [{ "t": "Deset", "word": "deset", "pos": "num" }, { "t": "racků", "word": "racek", "pos": "noun" }, { "t": "sedí", "word": "sedext", "pos": "verb" }, { "t": "na", "word": "na", "pos": "prep" }, { "t": "stožáru", "word": "stozxaar", "pos": "noun" }] }
  ]
}
