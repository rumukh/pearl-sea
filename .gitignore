# Dependencies and build output
node_modules/
dist-site/
out/
coverage/
*.tsbuildinfo
# A build is staged next to its output and renamed into place; a killed build can leave one.
.*.staging-*/

# Playwright output (local runs and CI)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Reports a gate run writes about itself, consumed by the same run (scripts/verify.mjs).
# Never committed: a checked-in report is a claim about a run nobody can point at.
.verify-report.json
.vitest-report.json

# OS, editor and merge leftovers
.DS_Store
Thumbs.db
*.log
.tmp/
.cache/
*.bak
*.orig
*.rej
*.swp
*~
