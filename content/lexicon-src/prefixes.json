        { "rule": "predpona-predlozka", "word": "doplavat" },
        { "rule": "predpona-predlozka" }
      ]
    },
    {
      "id": "prefix.03",
      "text": "Želva {připlavala|při plavala} k lodi.",
      "gaps": [{ "rule": "predpona-predlozka", "word": "prxiplavat" }]
    },
    {
      "id": "prefix.04",
      "text": "Ponorka {podplula|pod plula} {pod mostem|podmostem}.",
