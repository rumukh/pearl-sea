  "sentences": [
    { "id": "hard-soft.01", "text": "Zlatá r{y|i}ba plave v zátoce.", "gaps": [{ "rule": "tvrda", "word": "ryba" }] },
    { "id": "hard-soft.02", "text": "Velr{y|i}ba d{ý|í}chá na hladině.", "gaps": [{ "rule": "tvrda", "word": "velryba" }, { "rule": "tvrda", "word": "dyychat" }] },
    { "id": "hard-soft.03", "text": "Potápěč d{ý|í}chá pod vodou z láhve.", "gaps": [{ "rule": "tvrda", "word": "dyychat" }] },
    { "id": "hard-soft.04", "text": "R{y|i}bář ch{y|i}tá r{y|i}by.", "gaps": [{ "rule": "tvrda", "word": "rybaarx" }, { "rule": "tvrda", "word": "chytat" }, { "rule": "tvrda", "word": "ryba" }] },
    { "id": "hard-soft.05", "text": "Žralok je r{y|i}chlý a ch{y|i}trý.", "gaps": [{ "rule": "tvrda", "word": "rychlyy" }, { "rule": "tvrda", "word": "chytryy" }] },
    { "id": "hard-soft.06", "text": "Inkoust schoval ve větě ch{y|i}bu.", "gaps": [{ "rule": "tvrda", "word": "chyba" }] },
    { "id": "hard-soft.07", "text": "Námořník hraje na k{y|i}taru.", "gaps": [{ "rule": "tvrda", "word": "kytara" }] },
    { "id": "hard-soft.08", "text": "Kor{ý|í}š má tvrdý krun{ý|í}ř.", "gaps": [{ "rule": "tvrda", "word": "koryysx" }, { "rule": "tvrda", "word": "krunyyrx" }] },
    { "id": "hard-soft.09", "text": "Chobotnice je mořský měkk{ý|í}š.", "gaps": [{ "rule": "tvrda", "word": "mexkkyysx" }] },
    { "id": "hard-soft.10", "text": "Na lodi měli námořníci velkou ž{í|ý}zeň.", "gaps": [{ "rule": "mekka", "word": "zxiizenx" }] },
    { "id": "hard-soft.11", "text": "Moře je š{i|y}roké a hluboké.", "gaps": [{ "rule": "mekka", "word": "sxirokyy" }] },
    { "id": "hard-soft.12", "text": "Voda v zátoce je č{i|y}stá.", "gaps": [{ "rule": "mekka", "word": "cxistyy" }] },
    { "id": "hard-soft.13", "text": "Ďas č{í|ý}há ve tmě na rybky.", "gaps": [{ "rule": "mekka", "word": "cxiihat" }] },
    { "id": "hard-soft.14", "text": "Ponorka má na boku č{í|ý}slo.", "gaps": [{ "rule": "mekka", "word": "cxiislo" }] },
    { "id": "hard-soft.15", "text": "Kapitán ř{í|ý}d{í|ý} loď.", "gaps": [{ "rule": "mekka", "word": "rxiidit" }, { "rule": "dtn-mekke", "word": "rxiidit" }] },
    { "id": "hard-soft.16", "text": "Racek mává kř{í|ý}dly.", "gaps": [{ "rule": "mekka", "word": "krxiidlo" }] },
    { "id": "hard-soft.17", "text": "Loď pluje k c{í|ý}li.", "gaps": [{ "rule": "mekka", "word": "ciil" }] },
    { "id": "hard-soft.18", "text": "Na j{i|y}hu je teplé moře.", "gaps": [{ "rule": "mekka", "word": "jih" }] },
    { "id": "hard-soft.19", "text": "Pro tuleně je ryba nejlepší j{í|ý}dlo.", "gaps": [{ "rule": "mekka", "word": "jiidlo" }] },
    { "id": "hard-soft.20", "text": "Š{i|y}pka ukazuje cestu k pokladu.", "gaps": [{ "rule": "mekka", "word": "sxipka" }] },
    { "id": "hard-soft.21", "text": "Na pobřeží stojí staré d{i|y}vadlo.", "gaps": [{ "rule": "dtn-mekke", "word": "divadlo" }] },
    { "id": "hard-soft.22", "text": "Malé d{í|ý}t{ě|e} staví hrad z písku.", "gaps": [{ "rule": "dtn-mekke", "word": "diitex" }, { "rule": "de-te-ne", "word": "diitex" }] },
    { "id": "hard-soft.23", "text": "Pod vodou je velké t{i|y}cho.", "gaps": [{ "rule": "dtn-mekke", "word": "ticho" }] },
    { "id": "hard-soft.24", "text": "V oceánu žijí t{i|y}síce ryb.", "gaps": [{ "rule": "dtn-mekke", "word": "tisiic" }] },
    { "id": "hard-soft.25", "text": "N{i|y}kdo neví, kde je poklad.", "gaps": [{ "rule": "dtn-mekke", "word": "nikdo" }] },
    { "id": "hard-soft.26", "text": "N{i|y}kdy neplav sám daleko od břehu.", "gaps": [{ "rule": "dtn-mekke", "word": "nikdy" }] },
    { "id": "hard-soft.27", "text": "V r{y|i}bn{í|ý}ku plavou kapři.", "gaps": [{ "rule": "tvrda", "word": "rybniik" }, { "rule": "dtn-mekke", "word": "rybniik" }] },
    { "id": "hard-soft.28", "text": "Ptáci si staví hn{í|ý}zda na útesech.", "gaps": [{ "rule": "dtn-mekke", "word": "hniizdo" }] },
    { "id": "hard-soft.29", "text": "T{y|i} jsi můj nejlepší kamarád.", "gaps": [{ "rule": "tvrda", "word": "ty" }] },
    { "id": "hard-soft.30", "text": "Za t{ý|í}den pojedeme k moři.", "gaps": [{ "rule": "tvrda", "word": "tyyden" }] },
    { "id": "hard-soft.31", "text": "Na podzim zdobíme d{ý|í}ně.", "gaps": [{ "rule": "tvrda", "word": "dyynex" }] },
    { "id": "hard-soft.32", "text": "N{y|i}n{í|ý} se ponoříme.", "gaps": [{ "rule": "tvrda", "word": "nynii" }, { "rule": "dtn-mekke", "word": "nynii" }] },
    { "id": "hard-soft.33", "text": "T{y|i}gr je velká kočka.", "gaps": [{ "rule": "tvrda", "word": "tygr" }] },
    { "id": "hard-soft.34", "text": "Mořská želva se pomalu h{ý|í}bá.", "gaps": [{ "rule": "tvrda", "word": "hyybat" }] },
    { "id": "hard-soft.35", "text": "Na ostrově žijí d{i|y}voká zvířata.", "gaps": [{ "rule": "dtn-mekke", "word": "divokyy" }] },
    { "id": "hard-soft.36", "text": "D{í|ý}vka sbírá mušle.", "gaps": [{ "rule": "dtn-mekke", "word": "diivka" }] },
    { "id": "hard-soft.37", "text": "Z ohně létají j{i|y}skry.", "gaps": [{ "rule": "mekka", "word": "jiskra" }] },
    { "id": "hard-soft.38", "text": "Na pláži není n{i|y}c než písek.", "gaps": [{ "rule": "dtn-mekke", "word": "nic" }] }
  ]
