  "sentences": [
    {
      "id": "capitals.01",
      "text": "Na pláži si hraje {P|p}etr s {E|e}vou.",
      "gaps": [
        { "rule": "velke-pismeno", "word": "petr" },
        { "rule": "velke-pismeno", "word": "eva" }
      ]
    },
    {
      "id": "capitals.02",
      "text": "Náš pes {A|a}lík rád plave.",
      "gaps": [{ "rule": "velke-pismeno", "word": "aliik" }]
    },
    {
      "id": "capitals.03",
      "text": "Náš papoušek {F|f}erda umí mluvit.",
      "gaps": [{ "rule": "velke-pismeno", "word": "ferda" }]
    },
    {
      "id": "capitals.04",
      "text": "Ponorka {B|b}ublinka se ponořila.",
      "gaps": [{ "rule": "velke-pismeno", "word": "bublinka.ponorka" }]
    },
    {
      "id": "capitals.05",
      "text": "Profesorka {O|o}smička učí malé rybky.",
      "gaps": [{ "rule": "velke-pismeno", "word": "osmicxka.profesorka" }]
    },
    {
      "id": "capitals.06",
      "text": "Řeka {V|v}ltava teče přes {P|p}rahu.",
      "gaps": [
        { "rule": "velke-pismeno", "word": "vltava" },
        { "rule": "velke-pismeno", "word": "praha" }
      ]
    },
    {
      "id": "capitals.07",
      "text": "Vltava se vlévá do {L|l}abe.",
      "gaps": [{ "rule": "velke-pismeno", "word": "labe" }]
    },
    {
      "id": "capitals.08",
      "text": "Nejvyšší horou {Č|č}eska je {S|s}něžka.",
      "gaps": [
        { "rule": "velke-pismeno", "word": "cxesko" },
        { "rule": "velke-pismeno", "word": "snexzxka" }
      ]
    },
    {
      "id": "capitals.10",
      "text": "Babička bydlí v {O|o}lomouci.",
      "gaps": [{ "rule": "velke-pismeno", "word": "olomouc" }]
    },
    {
      "id": "capitals.11",
      "text": "Zítra jedeme do {B|b}rna.",
      "gaps": [{ "rule": "velke-pismeno", "word": "brno" }]
    },
    {
      "id": "capitals.12",
      "text": "V {C|c}horvatsku je teplé moře.",
      "gaps": [{ "rule": "velke-pismeno", "word": "chorvatsko" }]
    },
    {
      "id": "capitals.13",
      "text": "Na {Š|š}umavě jsou krásné lesy.",
      "gaps": [{ "rule": "velke-pismeno", "word": "sxumava" }]
    },
    {
      "id": "capitals.15",
      "text": "Můj kamarád {J|j}akub se umí potápět.",
      "gaps": [{ "rule": "velke-pismeno", "word": "jakub" }]
    },
    {
      "id": "capitals.16",
      "text": "V {D|d}unaji plavou velké ryby.",
      "gaps": [{ "rule": "velke-pismeno", "word": "dunaj" }]
    }
  ]
