  "sentences": [
    {
      "id": "paired.01",
      "text": "Na útesu stojí starý hra{d|t}.",
      "gaps": [{ "rule": "parova", "word": "hrad", "test": "hrady" }]
    },
    {
      "id": "paired.02",
      "text": "Mořský ha{d|t} se svíjí ve vodě.",
      "gaps": [{ "rule": "parova", "word": "had", "test": "hadi" }]
    },
    {
      "id": "paired.03",
      "text": "Moře pokryl tenký le{d|t}.",
      "gaps": [{ "rule": "parova", "word": "led", "test": "ledy" }]
    },
    {
      "id": "paired.04",
      "text": "Kra{b|p} cvaká klepety.",
      "gaps": [{ "rule": "parova", "word": "krab", "test": "krabi" }]
    },
    {
      "id": "paired.05",
      "text": "U pláže roste starý du{b|p}.",
      "gaps": [{ "rule": "parova", "word": "dub", "test": "duby" }]
    },
    {
      "id": "paired.06",
      "text": "Na pláži leží žraločí zu{b|p}.",
      "gaps": [{ "rule": "parova", "word": "zub", "test": "zuby" }]
    },
    {
      "id": "paired.07",
      "text": "Na horách leží sní{h|ch}, u moře je teplo.",
      "gaps": [{ "rule": "parova", "word": "sniih", "test": "sněhu" }]
    },
    {
      "id": "paired.08",
      "text": "Rybky vytvořily velký kru{h|ch}.",
      "gaps": [{ "rule": "parova", "word": "kruh", "test": "kruhy" }]
    },
    {
      "id": "paired.09",
      "text": "V noci byl na moři mrá{z|s}.",
      "gaps": [{ "rule": "parova", "word": "mraaz", "test": "mrazy" }]
    },
    {
      "id": "paired.10",
      "text": "Na pláži stojí dřevěný vů{z|s}.",
      "gaps": [{ "rule": "parova", "word": "vuoz", "test": "vozy" }]
    },
    {
      "id": "paired.11",
      "text": "Kuchař vzal ostrý nů{ž|š}.",
      "gaps": [{ "rule": "parova", "word": "nuozx", "test": "nože" }]
    },
    {
      "id": "paired.12",
      "text": "Celá plá{ž|š} je plná mušlí.",
      "gaps": [{ "rule": "parova", "word": "plaazx", "test": "pláže" }]
    },
    {
      "id": "paired.13",
      "text": "Na moři leží malý ostro{v|f}.",
      "gaps": [{ "rule": "parova", "word": "ostrov", "test": "ostrovy" }]
    },
    {
      "id": "paired.14",
      "text": "Lo{ď|ť} pluje do přístavu.",
      "gaps": [{ "rule": "parova", "word": "lodx", "test": "lodě" }]
    },
    {
      "id": "paired.15",
      "text": "Kapitán má hustý vou{s|z}.",
      "gaps": [{ "rule": "parova", "word": "vous", "test": "vousy" }]
    },
    {
      "id": "paired.16",
      "text": "Na stěně kajuty visí obra{z|s}.",
      "gaps": [{ "rule": "parova", "word": "obraz", "test": "obrazy" }]
    },
    {
      "id": "paired.17",
      "text": "Kolem zahrady vede dřevěný plo{t|d}.",
      "gaps": [{ "rule": "parova", "word": "plot", "test": "ploty" }]
    },
    {
      "id": "paired.18",
      "text": "Racek ukradl námořníkovi chlé{b|p}.",
      "gaps": [{ "rule": "parova", "word": "chleeb", "test": "chleba" }]
    },
    {
      "id": "paired.19",
      "text": "Na stožáru sedí holu{b|p}.",
      "gaps": [{ "rule": "parova", "word": "holub", "test": "holubi" }]
    },
    {
      "id": "paired.20",
      "text": "Kůň chroupe mrke{v|f}.",
      "gaps": [{ "rule": "parova", "word": "mrkev", "test": "mrkve" }]
    },
    {
      "id": "paired.21",
      "text": "Ry{b|p}ka se schovala v korálech.",
      "gaps": [{ "rule": "parova", "word": "rybka", "test": "ryba" }]
    },
    {
      "id": "paired.22",
      "text": "Ža{b|p}ka skáče do rybníka.",
      "gaps": [{ "rule": "parova", "word": "zxabka", "test": "žába" }]
    },
    {
      "id": "paired.23",
      "text": "Mezi racky vypukla há{d|t}ka o rybu.",
      "gaps": [{ "rule": "parova", "word": "haadka", "test": "hádat" }]
    },
    {
      "id": "paired.24",
      "text": "Mořská voda není sla{d|t}ká.",
      "gaps": [{ "rule": "parova", "word": "sladkyy", "test": "sladit" }]
    },
    {
      "id": "paired.25",
      "text": "Vezmi si na pláž pla{v|f}ky.",
      "gaps": [{ "rule": "parova", "word": "plavky", "test": "plavat" }]
    },
    {
      "id": "paired.26",
      "text": "Na stožáru se usadil vra{b|p}čák.",
      "gaps": [{ "rule": "parova", "word": "vrabcxaak", "test": "vrabec" }]
    },
    {
      "id": "paired.27",
      "text": "Kámen na pláži je hla{d|t}ký.",
      "gaps": [{ "rule": "parova", "word": "hladkyy", "test": "hladit" }]
    }
  ]
