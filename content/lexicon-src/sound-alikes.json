    },
    {
      "id": "alike.04",
      "text": "Delfíni b{y|i}li po závodě unavení.",
      "gaps": [{ "rule": "vyjm", "word": "byyt" }]
    },
    {
      "id": "alike.05",
      "text": "Kovář b{i|y}l kladivem do železa.",
      "gaps": [{ "rule": "obojetna-i", "word": "biit" }]
    },
    {
      "id": "alike.06",
      "text": "Před jídlem si musíme m{ý|í}t ruce.",
      "gaps": [{ "rule": "vyjm", "word": "myyt" }]
    },
    {
      "id": "alike.07",
      "text": "Chtěl bych m{í|ý}t odvahu jako kapitán.",
      "gaps": [{ "rule": "obojetna-i", "word": "miit" }]
    },
    {
      "id": "alike.08",
      "text": "V lese u moře houká v{ý|í}r.",
      "gaps": [{ "rule": "vyjm", "word": "vyyr" }]
    },
    {
      "id": "alike.09",
      "text": "Malou loďku strhl silný v{í|ý}r.",
      "gaps": [{ "rule": "obojetna-i", "word": "viir" }]
    },
    {
      "id": "alike.10",
      "text": "Včely sbírají p{y|i}l.",
      "gaps": [{ "rule": "vyjm", "word": "pyl" }]
    },
    {
      "id": "alike.11",
      "text": "Námořník p{i|y}l čaj z hrnku.",
      "gaps": [{ "rule": "obojetna-i", "word": "piit" }]
    },
    {
      "id": "alike.12",
      "text": "M{y|i} jsme kamarádi delfínů.",
      "gaps": [{ "rule": "vyjm", "word": "my" }]
    },
    {
      "id": "alike.13",
      "text": "Podej m{i|y} prosím tu mušli.",
      "gaps": [{ "rule": "obojetna-i", "word": "jaa" }]
    },
    {
      "id": "alike.14",
      "text": "V noci v{y|i}jí vlci.",
      "gaps": [{ "rule": "vyjm", "word": "vyyt" }]
    },
    {
      "id": "alike.15",
      "text": "Babička v{i|y}je věnec z květin.",
      "gaps": [{ "rule": "obojetna-i", "word": "viit" }]
    },
    {
      "id": "alike.16",
      "grade": 4,
      "text": "Piráti dob{y|i}li starý hrad.",
      "gaps": [{ "rule": "vyjm", "word": "dobyyt" }]
    },
    {
      "id": "alike.17",
      "grade": 4,
      "text": "Ponorka musí dob{í|ý}t baterie.",
      "gaps": [{ "rule": "obojetna-i", "word": "dobiit" }]
    },
    {
      "id": "alike.18",
      "text": "V přístavu začaly hodiny b{í|ý}t poledne.",
      "gaps": [{ "rule": "obojetna-i", "word": "biit" }]
    },
    {
      "id": "alike.19",
      "text": "Na pláži budeme v{í|ý}t věnečky z řas.",
      "gaps": [{ "rule": "obojetna-i", "word": "viit" }]
    },
    {
      "id": "alike.20",
      "text": "Rak poustevník si v ulitě našel nové b{y|i}dlo.",
      "gaps": [{ "rule": "vyjm", "word": "bydlo" }]
    },
    {
      "id": "alike.21",
      "text": "Rybář odstrčil loďku od mola dlouhým b{i|y}dlem.",
