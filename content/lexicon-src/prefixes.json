        { "rule": "predpona-predlozka", "word": "odplavat" },
        { "rule": "predpona-predlozka" }
      ]
    },
    {
      "id": "prefix.02",
      "text": "Delfín {doplaval|do plaval} {do zátoky|dozátoky}.",
