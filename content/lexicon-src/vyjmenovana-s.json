  "sentences": [
    {
      "id": "vyjm-s.01",
      "text": "Rybář vzal na moře svého s{y|i}na.",
      "gaps": [{ "rule": "vyjm", "word": "syn" }]
    },
    {
      "id": "vyjm-s.02",
      "text": "Žralok je konečně s{y|i}tý.",
      "gaps": [{ "rule": "vyjm", "word": "sytyy" }]
    },
    {
      "id": "vyjm-s.03",
      "text": "Myška ukradla námořníkům s{ý|í}r.",
      "gaps": [{ "rule": "vyjm", "word": "syyr" }]
    },
    {
      "id": "vyjm-s.04",
      "text": "Tuleň jí s{y|i}rové ryby.",
      "gaps": [{ "rule": "vyjm", "word": "syrovyy" }]
    },
    {
      "id": "vyjm-s.05",
      "text": "Venku je s{y|i}chravé počasí.",
      "gaps": [{ "rule": "vyjm", "word": "sychravyy" }]
    },
    {
      "id": "vyjm-s.06",
      "text": "Na pláži us{y|i}chají mořské řasy.",
      "gaps": [{ "rule": "vyjm", "word": "usychat" }]
    },
    {
      "id": "vyjm-s.07",
      "text": "Na stožáru sedí malá s{ý|í}korka.",
      "gaps": [{ "rule": "vyjm", "word": "syykorka" }]
    },
    {
      "id": "vyjm-s.08",
      "text": "V noci houká s{ý|í}ček.",
      "gaps": [{ "rule": "vyjm", "word": "syycxek" }]
    },
    {
      "id": "vyjm-s.09",
      "text": "S{y|i}sel prospí celou zimu v noře.",
      "gaps": [{ "rule": "vyjm", "word": "sysel" }]
    },
    {
      "id": "vyjm-s.10",
      "text": "Ježík se nafoukl a hlasitě s{y|i}čí.",
      "gaps": [{ "rule": "vyjm", "word": "sycxet" }]
    },
    {
      "id": "vyjm-s.11",
      "text": "Mořský had vydal tichý s{y|i}kot.",
      "gaps": [{ "rule": "vyjm", "word": "sykot" }]
    },
    {
      "id": "vyjm-s.12",
      "text": "Rybáři s{y|i}pou krmení rybám.",
      "gaps": [{ "rule": "vyjm", "word": "sypat" }]
    },
    {
      "id": "vyjm-s.13",
      "text": "Nas{y|i}pali jsme písek do kbelíku.",
      "gaps": [{ "rule": "vyjm", "word": "nasypat" }]
    },
    {
      "id": "vyjm-s.14",
      "text": "Perly se rozs{y|i}paly po dně.",
      "gaps": [{ "rule": "vyjm", "word": "rozsypat" }]
    },
    {
      "id": "vyjm-s.15",
      "text": "Rybník v létě v{y|i}s{y|i}chá.",
      "gaps": [
        { "rule": "vyjm-prefix", "word": "vysychat" },
        { "rule": "vyjm", "word": "vysychat" }
      ]
    },
    {
      "id": "vyjm-s.16",
      "text": "Delfíni se najedli dos{y|i}ta.",
      "gaps": [{ "rule": "vyjm", "word": "dosyta" }]
    },
    {
      "id": "vyjm-s.17",
      "text": "Malý s{y|i}nek staví hrad z písku.",
      "gaps": [{ "rule": "vyjm", "word": "synek" }]
    },
    {
      "id": "vyjm-s.18",
      "text": "Žralok je nenas{y|i}tný.",
      "gaps": [{ "rule": "vyjm", "word": "nenasytnyy" }]
    },
    {
      "id": "vyjm-s.19",
      "text": "Bábovku pos{y|i}peme cukrem.",
      "gaps": [{ "rule": "vyjm", "word": "posypat" }]
    },
    {
      "id": "vyjm-s.20",
      "text": "Rybáři táhnou plnou s{í|ý}ť.",
      "gaps": [{ "rule": "obojetna-i", "word": "siitx" }]
    },
    {
      "id": "vyjm-s.21",
      "text": "Velryba je velmi s{i|y}lná.",
      "gaps": [{ "rule": "obojetna-i", "word": "silnyy" }]
    },
    {
      "id": "vyjm-s.22",
      "text": "Krab má v klepetech velkou s{í|ý}lu.",
      "gaps": [{ "rule": "obojetna-i", "word": "siila" }]
    },
    {
      "id": "vyjm-s.23",
      "text": "Tuleň pros{i|y}l o rybu.",
      "gaps": [{ "rule": "obojetna-i", "word": "prosit" }]
    },
    {
      "id": "vyjm-s.24",
      "text": "Kuchař uvařil s{ý|í}rovou polévku.",
      "gaps": [{ "rule": "vyjm", "word": "syyrovyy" }]
    }
  ]
}
