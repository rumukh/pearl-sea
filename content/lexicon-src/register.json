  "sentences": [
    {
      "id": "register.01",
      "text": "Delfín má {velký|velkej} hlad.",
      "gaps": [{ "rule": "spisovne", "word": "velkyy" }]
    },
    {
      "id": "register.02",
      "text": "Otevři {okno|vokno}, je tu horko.",
      "gaps": [{ "rule": "spisovne", "word": "okno" }]
    },
    {
      "id": "register.03",
      "text": "Ke snídani mám {mléko|mlíko}.",
      "gaps": [{ "rule": "spisovne", "word": "mleeko" }]
    },
    {
      "id": "register.04",
      "text": "{Zítra|Zejtra} pojedeme k moři.",
      "gaps": [{ "rule": "spisovne", "word": "ziitra" }]
    },
    {
      "id": "register.05",
      "text": "Chci {být|bejt} námořníkem.",
      "gaps": [{ "rule": "spisovne", "word": "byyt" }]
    },
    {
      "id": "register.06",
      "text": "Umyj si ruce {mýdlem|mejdlem}.",
      "gaps": [{ "rule": "spisovne", "word": "myydlo" }]
    },
    {
      "id": "register.07",
      "text": "Racek {cítí|cejtí} rybu.",
      "gaps": [{ "rule": "spisovne", "word": "ciitit" }]
    },
    {
      "id": "register.08",
      "text": "Pes vrtí {ocasem|vocasem}.",
      "gaps": [{ "rule": "spisovne", "word": "ocas" }]
    },
    {
      "id": "register.09",
      "text": "To je {dobrý|dobrej} nápad!",
      "gaps": [{ "rule": "spisovne", "word": "dobryy" }]
    },
    {
      "id": "register.10",
      "text": "Babička uvařila rybí {polévku|polívku}.",
      "gaps": [{ "rule": "spisovne", "word": "poleevka" }]
    },
    {
      "id": "register.11",
      "text": "Na pobřeží stojí {mořský|mořskej} maják.",
      "gaps": [{ "rule": "spisovne", "word": "morxskyy" }]
    }
  ]
